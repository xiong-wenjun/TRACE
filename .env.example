# Copy to .env locally. Never include .env or real keys in a submission.
# Blank credentials are intentional; fill only providers required by your run.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides for JSON-based runners. API_KEY_ENV is the NAME of a
# variable, not a secret. Empty overrides keep the recorded configuration.
TRACE_ACTOR_BASE_URL=
TRACE_ACTOR_MODEL=
TRACE_ACTOR_API_KEY_ENV=
TRACE_JUDGE_BASE_URL=
TRACE_JUDGE_MODEL=
TRACE_JUDGE_API_KEY_ENV=
TRACE_EMBEDDING_BASE_URL=
TRACE_EMBEDDING_MODEL=
TRACE_EMBEDDING_API_KEY_ENV=

# Generic credentials used by CLI-based runners.
TRACE_ACTOR_API_KEY=
TRACE_EMBEDDING_API_KEY=

# Optional local memory service (not a model provider).
TRACE_MEMOBASE_BASE_URL=
TRACE_MEMOBASE_API_KEY=
TRACE_MEM0_DEPS=
TRACE_GENERATION_LOCK_PATH=

# Direct SDK baseline integrations.
OPENAI_BASE_URL=https://api.openai.com/v1
